# ============================================================================
# AiAll · Docker Compose 环境变量模板
# ----------------------------------------------------------------------------
# 用法：复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）
#   cp .env.docker.example .env
#   然后 docker compose up -d --build
# 不改也可以直接启动，使用下方默认值。
# ============================================================================

# 对外访问端口（映射到容器内 80）
AIALL_PORT=8080

# 应用基础
AIGW_APP_NAME=AiAll 聚合网关
AIGW_APP_DEBUG=false
AIGW_APP_URL=http://localhost:8080

# 凭据加密主密钥（AES-256-GCM）。
# 生成：php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# 留空则首次启动自动生成并持久化；生产环境务必显式指定且勿中途更换。
AIGW_APP_KEY=

# 数据库（主机名固定为 db，勿改）
AIGW_DB_DATABASE=aigw
AIGW_DB_USERNAME=aigw
AIGW_DB_PASSWORD=aigw-secret
MYSQL_ROOT_PASSWORD=root-secret

# 首次安装的管理员口令（用户名固定 admin）。留空则首次启动随机生成并落盘提示。
AIGW_INSTALL_ADMIN_PASSWORD=

# 网关对外展示地址（仅用于界面展示接入地址）
AIGW_GATEWAY_PORT=51120
AIGW_GATEWAY_BASE_URL=http://localhost:8080
